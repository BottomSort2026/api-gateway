# Local development: cp .env.example .env
# Every variable is documented in README.md ("Environment variables").
# In Compose the variables come from compose.yaml and no .env file is used.

# Required. The MCP serves /chat and /lab/*; the engine is internal and has no variable here.
MCP_URL=http://localhost:8001

# Optional (README defaults shown)
# FRONTEND_URL=                      # unset: API-only
# PORT=3000
# PROFILES_MODE=static               # static | proxy
# PROFILES_PATH=/data/profiles.json
# PROFILES_UPSTREAM=                 # defaults to MCP_URL
# TRAINING_DATA_PATH=data/flex-training.csv
# CHAT_TIMEOUT_MS=120000
# UPSTREAM_TIMEOUT_MS=30000
# MAX_BODY_BYTES=1048576
# CORS_ALLOWED_ORIGIN_REGEX=         # default: any http://localhost:<port>
